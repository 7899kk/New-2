{
  "expo": {
    "name": "Pro Financer",
    "slug": "profinancer",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpg",
    "scheme": "profinancer",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.profinancer.app"
    },
    "android": {
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.profinancer.app",
      "blockedPermissions": [
        "android.permission.READ_SMS",
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_CONTACTS"
      ],
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6366f1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
